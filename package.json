{
  "name": "shaper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Document and breadboard tools for framing and shaping ideas",
  "engines": { "node": ">=22.18.0" },
  "packageManager": "pnpm@10.30.3",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/breadboard.schema.json",
    "./geometry": "./src/geometry.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.3"
  }
}
