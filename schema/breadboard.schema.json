{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Breadboard 0.1 (experimental)",
  "type": "object",
  "required": ["version", "title", "nodes"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "0.1"},
    "title": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/node"}
    },
    "areas": {
      "type": "object", "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {
        "type": "object", "required": ["label"], "additionalProperties": false,
        "properties": {"label": {"type": "string", "minLength": 1, "pattern": "\\S"}, "metadata": {"type": "object"}}
      }
    },
    "associations": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/association"}
    },
    "scenarios": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario"}
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "associations": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "object", "required": ["x"], "additionalProperties": false,
            "properties": {"x": {"type": "number"}}
          }
        },
        "connections": {
          "type": "object",
          "additionalProperties": {
            "type": "object", "required": ["x"], "additionalProperties": false,
            "properties": {"x": {"type": "number"}}
          }
        },
        "nodes": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          }
        }
      }
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "affordanceRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\.[a-z][a-z0-9_-]*$"
    },
    "targetRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)?$"
    },
    "affordance": {
      "type": "object",
      "required": ["kind", "label"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["action", "input", "copy", "capability", "event"]},
        "label": {"type": "string", "minLength": 1},
        "connections": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/connection"}
        },
        "metadata": {"type": "object"}
      }
    },
    "dataElement": {
      "type": "object", "required": ["label"], "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "attributes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}},
        "metadata": {"type": "object"}
      }
    },
    "association": {
      "type": "object", "required": ["from", "to"], "additionalProperties": false,
      "properties": {
        "from": {"$ref": "#/$defs/affordanceRef"},
        "to": {"$ref": "#/$defs/affordanceRef"},
        "label": {"type": "string"},
        "from_cardinality": {"enum": ["1", "0..1", "0..*", "1..*"]},
        "to_cardinality": {"enum": ["1", "0..1", "0..*", "1..*"]},
        "metadata": {"type": "object"}
      }
    },
    "node": {
      "type": "object",
      "required": ["kind", "label", "affordances"],
      "allOf": [{
        "if": {"properties": {"kind": {"const": "place"}}, "required": ["kind"]},
        "then": {"properties": {"data": false}}
      }],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["place", "component"]},
        "area": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "color": {"enum": ["slate", "gray", "brown", "red", "orange", "amber", "yellow", "lime", "green", "emerald", "teal", "cyan", "blue", "indigo", "violet", "pink"]},
        "affordances": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/affordance"}
        },
        "data": {
          "type": "object", "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"$ref": "#/$defs/dataElement"}
        },
        "affordance_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "metadata": {"type": "object"}
      }
    },
    "connection": {
      "type": "object",
      "required": ["to", "kind"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"login": {}}, "required": ["login"]}, "then": {"properties": {"kind": {"const": "navigate"}, "to": {"$ref": "#/$defs/id"}}}},
        {"if": {"properties": {"kind": {"const": "detour"}}, "required": ["kind"]}, "then": {"properties": {"to": {"$ref": "#/$defs/id"}}}}
      ],
      "properties": {
        "to": {"$ref": "#/$defs/targetRef"},
        "kind": {"enum": ["navigate", "detour", "invoke", "emit", "read", "write"]},
        "login": {
          "type": "object", "additionalProperties": false,
          "properties": {"via": {"$ref": "#/$defs/id"}}
        },
        "label": {"type": "string"},
        "metadata": {"type": "object"}
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "goal", "start", "steps", "end"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "goal": {"type": "string", "minLength": 1},
        "start": {"$ref": "#/$defs/id"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/affordanceRef"}},
        "end": {"$ref": "#/$defs/id"},
        "metadata": {"type": "object"}
      }
    }
  }
}
